# URL de tu sistema interno (recibe el JSON de cada cotización).
COTIZAR_WEBHOOK_URL=

# Opcional: token Bearer si tu API lo pide.
COTIZAR_WEBHOOK_TOKEN=

# Dominio canónico del sitio (SEO, sitemap, OG, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://sintropia.mx

# Opcional: Google Analytics 4 (gtag). Vacío = no se carga el script.
NEXT_PUBLIC_GA_ID=

# Opcional: meta de verificación de Google Search Console.
GOOGLE_SITE_VERIFICATION=
